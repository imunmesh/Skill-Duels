# Server Environment Configuration (EDU-WEB-2026-115 / NFR-03)
# Copy this file to .env and replace the values with your local settings.

# Port on which the Express & Socket.IO server will run
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/skillduels
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/skillduels?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skillduels

# JSON Web Token Secret Key (Use a strong random string in production)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars

# JWT Expiration Time (e.g. '1d', '7d', '24h')
JWT_EXPIRES_IN=7d

# Allowed CORS Origin for Client (React Frontend)
CLIENT_URL=http://localhost:5173
