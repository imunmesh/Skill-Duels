{
  "name": "skillduels",
  "version": "1.0.0",
  "description": "SkillDuels - Competitive Learning & Quiz Battle Platform (MERN + Socket.IO)",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "npm run server",
    "test": "npm run test:unit --prefix server",
    "lint": "npm run lint --prefix server",
    "build:client": "npm run build --prefix client",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "author": "SkillDuels Dev Team",
  "license": "ISC"
}
